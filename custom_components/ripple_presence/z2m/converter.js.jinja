// Ripple: sensing cluster 0xfc57 and the request channel used by the Ripple integration.
const RIPPLE_MANUF = 0x1141;
const RIPPLE_BOOT = Math.floor(Math.random() * 0x7fffffff);
let rippleSeq = 0;
const T = Zcl.DataType;
const rippleNamed = (o) => Object.fromEntries(Object.entries(o).map(([k, v]) => [k, {name: k, ...v}]));
const rippleCluster = {
    name: "rippleSense",
    ID: 0xfc57,
    manufacturerCode: RIPPLE_MANUF,
    attributes: rippleNamed({
        a_ff30: {ID: 0xff30, type: T.OCTET_STR},
        a_ff31: {ID: 0xff31, type: T.UINT8, write: true},
        a_ff39: {ID: 0xff39, type: T.UINT8, write: true},
        a_ff40: {ID: 0xff40, type: T.UINT8},
        a_ff41: {ID: 0xff41, type: T.UINT16, write: true},
        a_ff42: {ID: 0xff42, type: T.UINT8, write: true},
        a_ff43: {ID: 0xff43, type: T.BITMAP8},
        a_ff44: {ID: 0xff44, type: T.UINT8},
        a_ff45: {ID: 0xff45, type: T.UINT16},
        a_ff46: {ID: 0xff46, type: T.BITMAP16},
        a_ff47: {ID: 0xff47, type: T.OCTET_STR},
        a_ff48: {ID: 0xff48, type: T.OCTET_STR},
        a_ff49: {ID: 0xff49, type: T.UINT8},
        a_ff4a: {ID: 0xff4a, type: T.UINT8, write: true},
        a_ff4b: {ID: 0xff4b, type: T.OCTET_STR},
        a_ff4c: {ID: 0xff4c, type: T.OCTET_STR},
        a_ff4d: {ID: 0xff4d, type: T.OCTET_STR},
        a_ff4e: {ID: 0xff4e, type: T.OCTET_STR},
        a_ff4f: {ID: 0xff4f, type: T.UINT8, write: true},
    }),
    commands: rippleNamed({
        c_00: {ID: 0x00, parameters: [{name: "data", type: Zcl.BuffaloZclDataType.BUFFER}]},
        c_01: {ID: 0x01, parameters: [{name: "data", type: Zcl.BuffaloZclDataType.BUFFER}]},
        c_02: {ID: 0x02, parameters: [{name: "data", type: Zcl.BuffaloZclDataType.BUFFER}]},
        c_03: {ID: 0x03, parameters: [{name: "data", type: Zcl.BuffaloZclDataType.BUFFER}]},
        c_04: {ID: 0x04, parameters: [{name: "data", type: Zcl.BuffaloZclDataType.BUFFER}]},
    }),
    commandsResponse: {},
};

const rippleOut = (v) => (Buffer.isBuffer(v) ? {hex: v.toString("hex")} : v);
const rippleIn = (v) => (v && typeof v === "object" && typeof v.hex === "string" ? Buffer.from(v.hex, "hex") : v);

const rippleCl = (device, cluster, manuf) => Zcl.Utils.getCluster(cluster, manuf, device.customClusters);
const rippleOpts = (opts, cl) => (opts.manufacturerCode == null && cl.manufacturerCode != null ? {...opts, manufacturerCode: cl.manufacturerCode} : opts);

// Attribute names back to numeric ids, values made JSON-safe.
const rippleIds = (cl, data) => {
    const out = {};
    for (const [k, v] of Object.entries(data)) {
        const a = cl.attributes[k];
        const id = a ? a.ID : Number(k);
        if (!Number.isNaN(id)) out[id] = rippleOut(v);
    }
    return out;
};

const rippleNames = (cl, attrs) => attrs.map((id) => Object.values(cl.attributes).find((a) => a.ID === id)?.name ?? id);

const rippleReport = {
    cluster: "rippleSense",
    type: ["attributeReport", "readResponse"],
    convert: (model, msg, publish, options, meta) => {
        const cl = rippleCl(meta.device, msg.cluster, RIPPLE_MANUF);
        rippleSeq += 1;
        return {ripple: {b: RIPPLE_BOOT, n: rippleSeq, ep: msg.endpoint.ID, cluster: cl.ID, attrs: rippleIds(cl, msg.data)}};
    },
};

const rippleOccupancy = {
    cluster: "msOccupancySensing",
    type: ["attributeReport", "readResponse"],
    convert: (model, msg, publish, options, meta) => {
        const cl = rippleCl(meta.device, msg.cluster);
        rippleSeq += 1;
        return {ripple: {b: RIPPLE_BOOT, n: rippleSeq, ep: msg.endpoint.ID, cluster: cl.ID, attrs: rippleIds(cl, msg.data)}};
    },
};

const rippleTarget = (device, ieee, ep) => {
    const dst = device.constructor.byIeeeAddr(ieee);
    const e = dst?.getEndpoint(ep);
    if (!e) throw new Error(`unknown target ${ieee}/${ep}`);
    return e;
};

// One request in, one reply out: {id, op, ...} -> {id, ok, ...}; errors carry the ZCL/ZDO status when there is one.
const rippleRun = async (device, req) => {
    if (!device.customClusters?.rippleSense) device.addCustomCluster("rippleSense", rippleCluster);
    const ep = device.getEndpoint(req.ep ?? 1);
    if (!ep && !["binds"].includes(req.op)) throw new Error(`no endpoint ${req.ep}`);
    const opts = req.manuf != null ? {manufacturerCode: req.manuf} : {};
    if (req.timeout) opts.timeout = req.timeout;
    if (req.op === "read") {
        const cl = rippleCl(device, req.cluster, req.manuf);
        const data = await ep.read(cl.name, rippleNames(cl, req.attrs), rippleOpts(opts, cl));
        return {attrs: rippleIds(cl, data)};
    }
    if (req.op === "write") {
        const cl = rippleCl(device, req.cluster, req.manuf);
        const ids = Object.keys(req.attrs).map(Number);
        const names = rippleNames(cl, ids);
        await ep.write(cl.name, Object.fromEntries(ids.map((id, i) => [names[i], rippleIn(req.attrs[id])])), rippleOpts(opts, cl));
        return {};
    }
    if (req.op === "command") {
        const cl = rippleCl(device, req.cluster, req.manuf);
        const cmd = Object.values(cl.commands).find((c) => c.ID === req.cmd);
        if (!cmd) throw new Error(`unknown command ${req.cmd}`);
        await ep.command(cl.name, cmd.name, {data: rippleIn(req.payload)}, rippleOpts(opts, cl));
        return {};
    }
    if (req.op === "binds") {
        const table = await device.bindingTable();
        return {
            entries: table.map((b) => ({
                src_ep: b.sourceEndpoint,
                cluster: b.clusterId,
                mode: b.destAddrMode,
                dst: typeof b.dest === "string" ? b.dest : null,
                group: typeof b.dest === "number" ? b.dest : null,
                dst_ep: b.destEndpoint ?? null,
            })),
        };
    }
    if (req.op === "bind" || req.op === "unbind") {
        const src = device.getEndpoint(req.src_ep);
        if (!src) throw new Error(`no endpoint ${req.src_ep}`);
        const dst = rippleTarget(device, req.dst, req.dst_ep);
        if (req.op === "bind") await src.bind(req.cluster, dst);
        else await src.unbind(req.cluster, dst, true);
        return {};
    }
    throw new Error(`unknown op ${req.op}`);
};

const rippleRequest = {
    key: ["ripple"],
    convertSet: async (entity, key, value, meta) => {
        const device = meta.device;
        let reply;
        try {
            reply = {id: value.id, ok: true, ...(await rippleRun(device, value))};
        } catch (e) {
            const status = e?.code ?? (typeof e?.status === "number" ? e.status : null);
            reply = {id: value.id, ok: false, status, error: String(e?.message ?? e)};
        }
        meta.publish({ripple_reply: reply});
        return {};
    },
};

const ripple = () => [
    deviceAddCustomCluster("rippleSense", rippleCluster),
    {isModernExtend: true, fromZigbee: [rippleReport, rippleOccupancy], toZigbee: [rippleRequest], exposes: []},
];

const definitions = [
{% for device in devices %}
    {
        zigbeeModel: [
        {% for zb_model in device.zb_models %}
            "{{zb_model}}",
        {% endfor %}
        ],
        model: "{{device.model}}",
        vendor: "Ripple",
        description: {{device.description|tojson}},
        {% set first_endpoint = device.switchNames[0] if device.switchNames else (device.relayNames[0] if device.relayNames else device.coverNames[0]) %}
        extend: [
            ...ripple(),
            {% if device.has_battery_cluster %}
            romasku.batteryPercentage(),
            {% endif %}
            deviceEndpoints({ endpoints: {
                {%- for switchName in device.switchNames -%}
                    "{{switchName}}": {{loop.index}},{{" "}}
                {%- endfor -%}
                {%- for relayName in device.relayNames -%}
                    "{{relayName}}": {{loop.index  + (device.switchNames | length)}},{{" "}}
                {%- endfor -%}
                {%- for coverSwitchName in device.coverSwitchNames -%}
                    "{{coverSwitchName}}": {{loop.index + (device.switchNames | length) + (device.relayNames | length)}},{{" "}}
                {%- endfor -%}
                {%- for coverName in device.coverNames -%}
                    "{{coverName}}": {{loop.index + (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length)}},{{" "}}
                {%- endfor -%}
            } }),
            {% set first_endpoint = device.switchNames[0] if device.switchNames else (device.relayNames[0] if device.relayNames else (device.coverSwitchNames[0] if device.coverSwitchNames else device.coverNames[0])) %}
            romasku.deviceConfig("device_config", "{{first_endpoint}}"),
            romasku.multiPressResetCount("multi_press_reset_count", "{{first_endpoint}}"),
            {% if device.has_dedicated_net_led %}
            romasku.networkIndicator("network_led", "{{first_endpoint}}"),
            {% endif%}
            {% if device.relayNames %}
            onOff({ endpointNames: {{device.relayNames | tojson }} }),
            {% endif %}
            {% for switchName in device.switchNames %}
            romasku.pressAction("{{switchName}}_press_action", "{{switchName}}"),
            romasku.switchMode("{{switchName}}_mode", "{{switchName}}"),
            romasku.switchAction("{{switchName}}_action_mode", "{{switchName}}"),
            {% if device.relayNames %}
            romasku.relayMode("{{switchName}}_relay_mode", "{{switchName}}"),
            romasku.relayIndex("{{switchName}}_relay_index", "{{switchName}}", {{device.relayNames | length}}),
            {% endif %}
            romasku.bindedMode("{{switchName}}_binded_mode", "{{switchName}}"),
            romasku.longPressDuration("{{switchName}}_long_press_duration", "{{switchName}}"),
            romasku.levelMoveRate("{{switchName}}_level_move_rate", "{{switchName}}"),
            {% endfor %}
            {% for relayName in device.relayIndicatorNames %}
            romasku.relayIndicatorMode("{{relayName}}_indicator_mode", "{{relayName}}"),
            romasku.relayIndicator("{{relayName}}_indicator", "{{relayName}}"),
            {% endfor %}
            {% for coverName in device.coverNames %}
            windowCovering({ 
                controls: ["lift"],
                coverInverted: true,
                configureReporting: true,
                endpointNames: ["{{coverName}}"]
            }),
            romasku.coverMoving("moving", "{{coverName}}"),
            romasku.coverMotorReversal("{{coverName}}_motor_reversal", "{{coverName}}"),
            romasku.coverOpenTime("{{coverName}}_open_time", "{{coverName}}"),
            romasku.coverCloseTime("{{coverName}}_close_time", "{{coverName}}"),
            romasku.coverOpenDeadzone("{{coverName}}_open_deadzone", "{{coverName}}"),
            romasku.coverClosedDeadzone("{{coverName}}_closed_deadzone", "{{coverName}}"),
            {% endfor %}
            {% for coverSwitchName in device.coverSwitchNames %}
            romasku.coverSwitchPressAction("{{coverSwitchName}}_press_action", "{{coverSwitchName}}"),
            romasku.coverSwitchType("{{coverSwitchName}}_type", "{{coverSwitchName}}"),
            romasku.coverSwitchInvert("{{coverSwitchName}}_invert", "{{coverSwitchName}}"),
            {% if device.coverNames %}
            romasku.coverSwitchCoverIndex("{{coverSwitchName}}_cover_index", "{{coverSwitchName}}", {{device.coverNames | length}}),
            romasku.coverSwitchLocalMode("{{coverSwitchName}}_local_mode", "{{coverSwitchName}}"),
            {% endif %}
            romasku.coverSwitchBindedMode("{{coverSwitchName}}_binded_mode", "{{coverSwitchName}}"),
            romasku.coverSwitchLongPressDuration("{{coverSwitchName}}_long_press_duration", "{{coverSwitchName}}"),
            {% endfor %}
        ],
        meta: { multiEndpoint: true },
        configure: async (device, coordinatorEndpoint, logger) => {
            try {
                await reporting.bind(device.getEndpoint(1), coordinatorEndpoint, ["msOccupancySensing"]);
            } catch (e) {
                // Ripple boards without sensing have no occupancy cluster.
            }
            {% for switchName in device.switchNames %}
            const endpoint{{loop.index}} = device.getEndpoint({{loop.index}});
            await reporting.bind(endpoint{{loop.index}}, coordinatorEndpoint, ["genMultistateInput"]);
            // switch action:
            await endpoint{{loop.index}}.configureReporting("genMultistateInput", [
                {
                    attribute: {ID: 0x0055 /* presentValue */, type: 0x21}, // uint16
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}
            {% if device.has_battery_cluster %}
            // Battery reporting
            const batteryEndpoint = device.getEndpoint(1);
            await reporting.bind(batteryEndpoint, coordinatorEndpoint, ["genPowerCfg"]);
            await batteryEndpoint.configureReporting("genPowerCfg", [
                {
                    attribute: {ID: 0x0021, type: 0x20}, // BatteryPercentageRemaining
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.HOUR,
                    reportableChange: 2, // 1% (2 in ZCL 0-200 format)
                },
            ]);
            await batteryEndpoint.read("genPowerCfg", [0x0021, 0x0020]);
            {% endif %}
            {% for relayName in device.relayNames %}
            const endpoint{{loop.index  + (device.switchNames | length)}} = device.getEndpoint({{loop.index  + (device.switchNames | length)}});
            await reporting.onOff(endpoint{{loop.index  + (device.switchNames | length)}}, {
                min: 0,
                max: constants.repInterval.MAX,
                change: 1,
            });
            {% endfor %}

            {% for relayName in device.relayIndicatorNames %}
            await endpoint{{loop.index  + (device.switchNames | length)}}.configureReporting("genOnOff", [
                {
                    attribute: {ID: 0xff02, type: 0x10}, // Boolean
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}

            {% for coverSwitchName in device.coverSwitchNames %}
            const coverSwitch{{loop.index}} = device.getEndpoint({{loop.index + (device.switchNames | length) + (device.relayNames | length)}});
            await reporting.bind(coverSwitch{{loop.index}}, coordinatorEndpoint, ["genMultistateInput"]);
            await coverSwitch{{loop.index}}.configureReporting("genMultistateInput", [
                {
                    attribute: "presentValue",
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}

            {% for coverName in device.coverNames %}
            const cover{{loop.index}} = device.getEndpoint({{loop.index + (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length)}});
            await reporting.bind(cover{{loop.index}}, coordinatorEndpoint, ["closuresWindowCovering"]);
            await cover{{loop.index}}.configureReporting("closuresWindowCovering", [
                {
                    attribute: {ID: 0xff00, type: Zcl.DataType.ENUM8},
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}
        },
        ota: true,
    },
{% endfor %}
];

module.exports = definitions;
