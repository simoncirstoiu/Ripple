// Generated by the Ripple integration from its board table; Zigbee2MQTT loads it as an external converter.
// The switch part follows tuya-zigbee-switch (MIT, Copyright (c) Roman Skurikhin and contributors).

const romasku = {
    switchAction: (name, endpointName) =>
        enumLookup({
